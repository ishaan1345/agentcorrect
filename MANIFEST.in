include README.md
include LICENSE
include pyproject.toml
include requirements.txt

# Include all fixture files
recursive-include agentcorrect/fixtures *.jsonl

recursive-include tests *.py
recursive-include docs *.md

# Include verification scripts
include verify.py
include determinism_test.py
include ship_tests.py
include quick_proof.sh

# Include GitHub workflows
recursive-include .github *.yml

# Include examples
recursive-include examples *.py

# Exclude development files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .git
global-exclude .gitignore
global-exclude *.egg-info
global-exclude ._*
